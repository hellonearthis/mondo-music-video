{
  "_note": "Maps pipeline parameters onto node IDs in h3_ref2video_audionodeadded.json. Nothing in the code hardcodes a node number. If ComfyUI changes and you re-export the graph, edit this file and touch nothing else.",

  "workflow": "workflows/h3_ref2video_audionodeadded.json",

  "targets": {
    "prompt":          {"node": "138", "field": "value"},
    "duration_input":  {"node": "132", "field": "value"},
    "seed":            {"node": "129", "field": "noise_seed"},
    "width":           {"node": "136", "field": "width"},
    "height":          {"node": "136", "field": "height"},
    "steps":           {"node": "124", "field": "steps"},
    "sampler":         {"node": "123", "field": "sampler_name"},
    "scheduler":       {"node": "124", "field": "scheduler"},
    "video_prefix":    {"node": "148", "field": "filename_prefix"},
    "audio_prefix":    {"node": "147", "field": "filename_prefix"},
    "savevideo_prefix":{"node": "92",  "field": "filename_prefix"}
  },

  "reference_node": "136",

  "audio_refs": {
    "socket_prefix": "ref_audios.ref_audio_",
    "loader_class": "LoadAudio",
    "loader_field": "audio",
    "template_node": "149",
    "max": 3
  },

  "image_refs": {
    "socket_prefix": "ref_images.ref_image_",
    "loader_class": "LoadImage",
    "loader_field": "image",
    "template_node": "137",
    "max": 9
  },

  "video_refs": {
    "socket_prefix": "ref_videos.ref_video_",
    "max": 3
  },

  "prune_nodes": ["115"],
  "_prune_note": "ResolutionSelector is orphaned once width/height are written as literals, which is what allows arbitrary aspect ratios instead of the dropdown's presets.",

  "node_id_base": 9000
}
