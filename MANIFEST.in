include install.sh install.ps1 AGENTS.md
recursive-include docs *.md
recursive-include skills *.md *.yaml

recursive-include docs *.json
recursive-include tests *.py *.json
recursive-include mmv/engine/config *.json
recursive-include mmv/engine/prompts *.md
recursive-include mmv/engine/workflows *.json
exclude docs/COMFY_CONTEST*.md

include examples/starter-cast/README.md examples/starter-cast/manifest.json
include examples/starter-cast/animal_pig.oap
include examples/starter-cast/robobabe1.oap
include examples/starter-cast/henchman_1.oap
include examples/starter-cast/human_female_casual_01.oap

exclude docs/how_to_video.md

include examples/style-presets/README.md examples/style-presets/manifest.json
include examples/style-presets/sun_bleach.json
include examples/style-presets/nature_doc.json
include examples/style-presets/industrial_decay.json
include examples/style-presets/noir_bw.json
include examples/style-presets/gel_wash_psych.json
include examples/style-presets/crt_1990s.json

# Private updater state can contain local source paths and installation logs.
global-exclude update-status.json update-install.log
